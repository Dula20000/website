# Trip videos live on disk only — GitHub hard-rejects any file over 100 MB,
# and these run from 6 MB to 549 MB. The photos alongside them are tracked.
taiwanpics/*.MOV
taiwanpics/*.mov
taiwanpics/*.MP4
taiwanpics/*.mp4

# Web-sized videos stay local: the repo is already ~950 MB and GitHub
# recommends staying under 1 GB. The page falls back to placeholders
# when these are absent, so the site still works without them.
taiwanpics/web/*.mp4
taiwanpics/web/*.m4v
